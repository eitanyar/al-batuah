{
  "name": "al-batuah-website",
  "version": "0.1.0",
  "private": true,
  "description": "Local development workspace for the Al Batuah static marketing website.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.mjs",
    "build:review": "node scripts/build-review-site.mjs",
    "pages:dev": "wrangler pages dev . --compatibility-date=2026-08-01",
    "build": "vite build"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "wrangler": "^4.118.0"
  }
}
